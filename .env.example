# Google OAuth client (Google Cloud console > APIs & Services > Credentials).
# Download the client as credentials.json, then run:
#   uv run python scripts/get_refresh_token.py
# to obtain GOOGLE_REFRESH_TOKEN.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Gemini API key, used by Pydantic AI.
GOOGLE_API_KEY=

# Supabase Postgres connection string (dashboard > Project Settings > Database).
DATABASE_URL=

# Models. Defaults live in app/config.py.
CLASSIFIER_MODEL=
AGENT_MODEL=

# Seconds between inbox polls. Default 60.
POLL_INTERVAL_SECONDS=

# Dashboard basic auth. Set a real password before exposing the dashboard.
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD=

# Silences the Pydantic AI startup banner.
PYDANTIC_AI_NO_BANNER=
