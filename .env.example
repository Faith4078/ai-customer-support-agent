GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
DATABASE_URL=
GOOGLE_API_KEY=your-key-from-aistudio
CLASSIFIER_MODEL=google:gemini-3.5-flash-lite
# Check the free-tier quota of the agent model before using it: one email costs about four
# requests, so a model capped at 20 requests per DAY cannot finish an eval run.
AGENT_MODEL=google:gemini-3.5-flash-lite
# Requests per minute per model. Keep it under the key's per-minute quota (free tier: 15).
MODEL_REQUESTS_PER_MINUTE=12
POLL_INTERVAL_SECONDS=30
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=
PYDANTIC_AI_NO_BANNER=1